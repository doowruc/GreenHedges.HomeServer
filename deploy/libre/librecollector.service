# systemd unit for LibreCollector. Installed by deploy/libre/deploy.sh into /etc/systemd/system/.
# The build goes in /opt/librecollector (read-only), run by Ubuntu's .NET runtime; data and logs in
# /var/lib/librecollector.
# Secrets go in /etc/librecollector/env (root:root, 0600); see deploy/libre/HOST-SETUP.md.
[Unit]
Description=LibreCollector (LibreLinkUp glucose archive)
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
User=librecollector
Group=librecollector
WorkingDirectory=/var/lib/librecollector
ExecStart=/opt/librecollector/GreenHedges.HomeServer.Collectors.Libre.Worker
EnvironmentFile=/etc/librecollector/env
Environment=DOTNET_ENVIRONMENT=Production
Restart=always
RestartSec=30

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/librecollector

[Install]
WantedBy=multi-user.target
