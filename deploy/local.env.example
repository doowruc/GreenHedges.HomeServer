# Personal defaults for the deploy and backup scripts.
# Copy to deploy/local.env (git-ignored, never committed) and edit. Shell syntax.

# SSH target for deploy/deploy.sh, deploy/<collector>/deploy.sh and deploy/libre/nightscout/deploy-nightscout.sh
# (else pass it as an argument). LIBRECOLLECTOR_SSH is still read if this isn't set.
COLLECTORS_SSH=you@your-host.lan

# Backup pull (deploy/mac/install-backup-pull.sh <libre|weather|vehicle-manager|pay-and-pensions>): your user and the
# host, as seen from the Mac that pulls. Shared by every service; WEATHERCOLLECTOR_USER / _HOST, VEHICLEMANAGER_…,
# PAYANDPENSIONS_… (or LIBRECOLLECTOR_…)
# override them for one. LIBRECOLLECTOR_USER / LIBRECOLLECTOR_HOST are still read if these aren't set.
COLLECTORS_USER=you
COLLECTORS_HOST=your-host.lan

# Optional, per service (LIBRECOLLECTOR_…, WEATHERCOLLECTOR_…, VEHICLEMANAGER_… or PAYANDPENSIONS_…)
#LIBRECOLLECTOR_BACKUP_DIR="$HOME/Backups/LibreCollector"
#LIBRECOLLECTOR_LAUNCHD_LABEL=local.librecollector.pull-backups
#WEATHERCOLLECTOR_BACKUP_DIR="$HOME/Backups/WeatherCollector"
#WEATHERCOLLECTOR_LAUNCHD_LABEL=local.weathercollector.pull-backups
#VEHICLEMANAGER_BACKUP_DIR="$HOME/Backups/VehicleManager"
#VEHICLEMANAGER_LAUNCHD_LABEL=local.vehiclemanager.pull-backups
#PAYANDPENSIONS_BACKUP_DIR="$HOME/Backups/PayAndPensions"
#PAYANDPENSIONS_LAUNCHD_LABEL=local.payandpensions.pull-backups
