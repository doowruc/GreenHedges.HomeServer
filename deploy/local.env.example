# Personal defaults for the deploy and backup scripts.
# Copy to deploy/local.env (git-ignored, never committed) and edit. Shell syntax.

# SSH target for deploy/deploy.sh, deploy/<collector>/deploy.sh and deploy/libre/nightscout/deploy-nightscout.sh
# (else pass it as an argument).
COLLECTORS_SSH=you@your-host.lan

# Backup pull (deploy/mac/install-backup-pull.sh <libre|weather|vehicle-manager|pay-and-pensions|utilities|presents|sure|freshrss>): your user
# and the host, as seen from the Mac that pulls. Shared by every service; LIBRECOLLECTOR_USER / _HOST,
# WEATHERCOLLECTOR_…, VEHICLEMANAGER_…, PAYANDPENSIONS_…, UTILITIES_…, PRESENTS_…, SURE_… or FRESHRSS_… override them for one.
COLLECTORS_USER=you
COLLECTORS_HOST=your-host.lan

# Optional, per service (LIBRECOLLECTOR_…, WEATHERCOLLECTOR_…, VEHICLEMANAGER_…, PAYANDPENSIONS_…, UTILITIES_…, PRESENTS_…, SURE_… or FRESHRSS_…)
#LIBRECOLLECTOR_BACKUP_DIR="$HOME/Backups/LibreCollector"
#LIBRECOLLECTOR_LAUNCHD_LABEL=local.librecollector.pull-backups
#WEATHERCOLLECTOR_BACKUP_DIR="$HOME/Backups/WeatherCollector"
#WEATHERCOLLECTOR_LAUNCHD_LABEL=local.weathercollector.pull-backups
#VEHICLEMANAGER_BACKUP_DIR="$HOME/Backups/VehicleManager"
#VEHICLEMANAGER_LAUNCHD_LABEL=local.vehiclemanager.pull-backups
#PAYANDPENSIONS_BACKUP_DIR="$HOME/Backups/PayAndPensions"
#PAYANDPENSIONS_LAUNCHD_LABEL=local.payandpensions.pull-backups
#UTILITIES_BACKUP_DIR="$HOME/Backups/Utilities"
#UTILITIES_LAUNCHD_LABEL=local.utilities.pull-backups
#PRESENTS_BACKUP_DIR="$HOME/Backups/Presents"
#PRESENTS_LAUNCHD_LABEL=local.presents.pull-backups
#SURE_BACKUP_DIR="$HOME/Backups/Sure"
#SURE_LAUNCHD_LABEL=local.sure.pull-backups
#FRESHRSS_BACKUP_DIR="$HOME/Backups/FreshRSS"
#FRESHRSS_LAUNCHD_LABEL=local.freshrss.pull-backups
