# /etc/caddy/caddy.env on the host (root, 0600). Never commit the real values.

# The apps are https://<app>.$HOME_DOMAIN (e.g. vehicles.home.example.com); a DNS-only wildcard record
# *.$HOME_DOMAIN points at svc:home's tailnet address.
HOME_DOMAIN=home.example.com

# Let's Encrypt account email (expiry warnings).
ACME_EMAIL=you@example.com

# Cloudflare API token: Zone > DNS > Edit, for the one zone only. Used for the certificate's DNS challenge.
CLOUDFLARE_API_TOKEN=
