# /etc/photos-offsite/photos-offsite.env on the host (root:photos-offsite, 0640), for photos-offsite.sh. Never commit the
# real values. See HOST-SETUP.md §6.

# The folders to copy, as name=folder pairs separated by spaces (no spaces in either). Each name is the top folder in
# the bucket, and what filters.txt refers to (/photos/…, /private/…). Never rename one: everything under it would be
# uploaded again (and the old copies deleted).
PHOTOS_OFFSITE_SOURCES=photos=/srv/backup/photos private=/srv/backup/photos-private

# healthchecks.io check "Photos off-site" (period 1 day, grace 15 hours).
HEARTBEAT_PING_URL=https://hc-ping.com/<uuid>

# Optional overrides (defaults in photos-offsite.sh):
# PHOTOS_OFFSITE_BWLIMIT=Mon-08:00,20M Mon-18:00,off Tue-08:00,20M Tue-18:00,off Wed-08:00,20M Wed-18:00,off Thu-08:00,20M Thu-18:00,off Fri-08:00,20M Fri-18:00,off
# PHOTOS_OFFSITE_TRANSFERS=4
# PHOTOS_OFFSITE_MAX_DELETE_PERCENT=10
