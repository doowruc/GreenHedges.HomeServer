# /etc/bookorbit/bookorbit.env on the host (root, 0600). Never commit the real values. Written by the host setup
# (HOST-SETUP.md, step 2); read by both containers.

# BookOrbit's public address (through Caddy), for its links and redirects.
APP_URL=https://books.home.example.com

# The host's bookorbit user and group: the app runs as them, and they own /srv/books and /var/lib/bookorbit/app.
PUID=
PGID=

# The database password, shared by the app and PostgreSQL. Only used inside the compose network.
POSTGRES_PASSWORD=

# Signs the app's sign-in tokens. Changing it signs everyone out.
JWT_SECRET=

# Needed once, on the setup page, to create the first admin account. Keep it in your password manager.
SETUP_BOOTSTRAP_TOKEN=
