# /etc/bookorbit/backup.env on the host (root, 0600), for backup.sh only (never the containers). Never commit the real
# values. See HOST-SETUP.md, "Backups".

# The shared off-site bucket (deploy/aws/offsite.yaml) and the age public key, as the other services use. Leave
# OFFSITE_BUCKET empty to keep local backups only.
OFFSITE_BUCKET=
OFFSITE_REGION=eu-west-2
OFFSITE_AGE_RECIPIENT=age1…
# BookOrbit's own write-only user, <stack>-bookorbit (PutObject under bookorbit/ only).
OFFSITE_ACCESS_KEY_ID=AKIA…
OFFSITE_SECRET_ACCESS_KEY=
# OFFSITE_PREFIX=bookorbit

# healthchecks.io check for the nightly backup (period 1 day, grace 2 hours).
HEARTBEAT_PING_URL=https://hc-ping.com/<uuid>
