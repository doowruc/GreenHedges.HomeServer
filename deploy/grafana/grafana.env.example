# /etc/grafana/grafana.env on the host (root, 0600). Never commit the real values.

# Grafana's public address (through Caddy), for its links and redirects.
GF_SERVER_ROOT_URL=https://grafana.home.example.com

# The admin account's password, used to create the account on Grafana's first start only (change it later in
# Grafana itself). Generated by the host setup; keep it in your password manager.
GF_SECURITY_ADMIN_PASSWORD=

# The read-only SQL Server login's password, for the Weather data source. Written by deploy/grafana/setup-database.sh.
WEATHER_DB_PASSWORD=
