    {
      "type": "stat",
      "title": "Today: min / max",
      "description": "Since midnight (UK time) of the range's last day.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "weather"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "DECLARE @to datetime2 = $__timeTo();\nDECLARE @day datetime2 = CAST(CAST(CAST(@to AT TIME ZONE 'UTC' AT TIME ZONE 'GMT Standard Time' AS date) AS datetime2) AT TIME ZONE 'GMT Standard Time' AT TIME ZONE 'UTC' AS datetime2);\nSELECT MIN(TemperatureMinC) AS [Min], MAX(TemperatureMaxC) AS [Max] FROM dbo.MinuteSummaries\nWHERE MinuteUtc >= @day AND MinuteUtc <= @to"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
