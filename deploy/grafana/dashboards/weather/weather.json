    {
      "type": "stat",
      "title": "Direction",
      "description": "Where the wind is coming from: the speed-weighted mean over the last 10 minutes of the range.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "weather"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "DECLARE @to datetime2 = $__timeTo();\nSELECT CASE WHEN d < 0 THEN d + 360 ELSE d END AS [From]\nFROM (\n  SELECT DEGREES(ATN2(SUM(WindAvgMs * SIN(RADIANS(WindDirDeg))), SUM(WindAvgMs * COS(RADIANS(WindDirDeg))))) AS d\n  FROM dbo.MinuteSummaries\n  WHERE MinuteUtc <= @to AND MinuteUtc > DATEADD(MINUTE, -10, @to) AND WindDirDeg IS NOT NULL\n  HAVING SUM(WindAvgMs) > 0) AS w"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "degree",
          "decimals": 0,
          "mappings": [
            {
              "type": "range",
