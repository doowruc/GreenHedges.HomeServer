    {
      "type": "timeseries",
      "title": "Temperature",
      "description": "Average per interval, with the range between the lowest and highest minute shaded, and the dew point.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "weather"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(MinuteUtc, $__interval, NULL), MIN(TemperatureMinC) AS [Min], MAX(TemperatureMaxC) AS [Max], AVG(TemperatureAvgC) AS [Temperature], AVG(CASE WHEN HumidityAvg > 0 THEN (243.12 * (LOG(HumidityAvg / 100.0) + 17.62 * TemperatureAvgC / (243.12 + TemperatureAvgC)) / (17.62 - (LOG(HumidityAvg / 100.0) + 17.62 * TemperatureAvgC / (243.12 + TemperatureAvgC)))) END) AS [Dew point]\nFROM dbo.MinuteSummaries\nWHERE $__timeFilter(MinuteUtc)\nGROUP BY $__timeGroup(MinuteUtc, $__interval)\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMin": null
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
