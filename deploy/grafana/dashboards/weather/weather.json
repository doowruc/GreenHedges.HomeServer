    {
      "type": "barchart",
      "title": "Wind directions",
      "description": "How often the wind came from each direction over the range: minutes with wind (calm left out), as a share of them.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "weather"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "WITH points AS (SELECT * FROM (VALUES (0, 'N'), (1, 'NNE'), (2, 'NE'), (3, 'ENE'), (4, 'E'), (5, 'ESE'), (6, 'SE'), (7, 'SSE'), (8, 'S'), (9, 'SSW'), (10, 'SW'), (11, 'WSW'), (12, 'W'), (13, 'WNW'), (14, 'NW'), (15, 'NNW')) AS p (n, name)),\ncounts AS (\n  SELECT CAST(ROUND(WindDirDeg / 22.5, 0) AS int) % 16 AS n, COUNT(*) AS minutes\n  FROM dbo.MinuteSummaries\n  WHERE $__timeFilter(MinuteUtc) AND WindDirDeg IS NOT NULL AND WindAvgMs >= 0.5\n  GROUP BY CAST(ROUND(WindDirDeg / 22.5, 0) AS int) % 16)\nSELECT p.name AS [From], ISNULL(100.0 * c.minutes / NULLIF(SUM(c.minutes) OVER (), 0), 0) AS [Share]\nFROM points p LEFT JOIN counts c ON c.n = p.n\nORDER BY p.n"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1
          }
        },
