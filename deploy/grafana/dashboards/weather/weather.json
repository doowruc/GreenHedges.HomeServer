    {
      "type": "stat",
      "title": "Humidity / dew point",
      "description": "Relative humidity (%) and dew point (\u00b0C).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "weather"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "DECLARE @to datetime2 = $__timeTo();\nSELECT TOP 1 HumidityAvg AS [Humidity], (243.12 * (LOG(HumidityAvg / 100.0) + 17.62 * TemperatureAvgC / (243.12 + TemperatureAvgC)) / (17.62 - (LOG(HumidityAvg / 100.0) + 17.62 * TemperatureAvgC / (243.12 + TemperatureAvgC)))) AS [Dew point] FROM dbo.MinuteSummaries\nWHERE MinuteUtc <= @to AND MinuteUtc > DATEADD(MINUTE, -30, @to) AND HumidityAvg > 0 AND TemperatureAvgC IS NOT NULL\nORDER BY MinuteUtc DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Humidity"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Dew point"
            },
            "properties": [
              {
                "id": "unit",
                "value": "celsius"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      },
