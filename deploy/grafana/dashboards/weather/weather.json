    {
      "type": "stat",
      "title": "Temperature",
      "description": "The latest minute's average (within the last 30 minutes of the range).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "weather"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "DECLARE @to datetime2 = $__timeTo();\nSELECT TOP 1 TemperatureAvgC AS [Temperature] FROM dbo.MinuteSummaries\nWHERE MinuteUtc <= @to AND MinuteUtc > DATEADD(MINUTE, -30, @to) AND TemperatureAvgC IS NOT NULL\nORDER BY MinuteUtc DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
