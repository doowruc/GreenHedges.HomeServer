    {
      "type": "stat",
      "title": "Wind / gust",
      "description": "Average wind and strongest gust over the last 10 minutes of the range.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "weather"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "DECLARE @to datetime2 = $__timeTo();\nSELECT AVG(WindAvgMs) * 2.23694 AS [Wind], MAX(GustMaxMs) * 2.23694 AS [Gust] FROM dbo.MinuteSummaries\nWHERE MinuteUtc <= @to AND MinuteUtc > DATEADD(MINUTE, -10, @to)"
        }
      ],
