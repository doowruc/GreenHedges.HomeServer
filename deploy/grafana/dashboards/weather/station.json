{
  "uid": "weather-station",
  "title": "Station",
  "description": "Reception and the sensor's health: how many messages arrive, signal, battery, and gaps.",
  "tags": [
    "weather"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "schemaVersion": 41,
  "panels": [
    {
      "type": "stat",
      "title": "Messages received",
      "description": "Station messages received over the range (from the first message ever, if later), as a share of one every 12 s.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "weather"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "DECLARE @from datetime2 = $__timeFrom(), @to datetime2 = $__timeTo();\nDECLARE @first datetime2 = (SELECT MIN(MinuteUtc) FROM dbo.MinuteSummaries);\nIF @first > @from SET @from = @first;\nIF @to > SYSUTCDATETIME() SET @to = SYSUTCDATETIME();\nSELECT 100.0 * SUM(Messages) / NULLIF(DATEDIFF(SECOND, @from, @to) / 12.0, 0) AS [Received]\nFROM dbo.MinuteSummaries WHERE MinuteUtc >= @from AND MinuteUtc < @to"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 90
              },
              {
                "color": "green",
                "value": 97
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "auto",
        "justifyMode": "center",
        "wideLayout": true,
        "showPercentChange": false
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "mssql",
        "uid": "weather"
      }
    },
    {
      "type": "stat",
      "title": "Battery",
      "description": "The sensor's latest battery flag.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "weather"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "DECLARE @to datetime2 = $__timeTo();\nSELECT TOP 1 CAST(BatteryOk AS int) AS [Battery] FROM dbo.MinuteSummaries WHERE MinuteUtc <= @to AND BatteryOk IS NOT NULL ORDER BY MinuteUtc DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 0,
                "to": 0.5,
                "result": {
                  "text": "LOW",
                  "color": "red"
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 0.5,
                "to": 1,
                "result": {
                  "text": "OK",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "background",
        "textMode": "auto",
        "justifyMode": "center",
        "wideLayout": true,
        "showPercentChange": false
      },
      "id": 2,
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "mssql",
        "uid": "weather"
      }
    },
    {
      "type": "stat",
      "title": "Signal (SNR)",
      "description": "Signal-to-noise ratio over the last hour of the range. Above about 15 dB decodes reliably.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "weather"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "DECLARE @to datetime2 = $__timeTo();\nSELECT AVG(SnrAvgDb) AS [SNR] FROM dbo.MinuteSummaries WHERE MinuteUtc <= @to AND MinuteUtc > DATEADD(HOUR, -1, @to)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dB",
          "decimals": 1,
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 12
              },
              {
                "color": "green",
                "value": 18
              }
            ]
          },
          "noValue": "No messages"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "auto",
        "justifyMode": "center",
        "wideLayout": true,
        "showPercentChange": false
      },
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "mssql",
        "uid": "weather"
      }
    },
    {
      "type": "stat",
      "title": "Last message",
      "description": "The latest minute with a station message (whatever the range).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "weather"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT DATEDIFF_BIG(MILLISECOND, '1970-01-01', MAX(MinuteUtc)) AS [Last] FROM dbo.MinuteSummaries"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow",
          "decimals": 0,
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "wideLayout": true,
        "showPercentChange": false
      },
      "id": 4,
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "mssql",
        "uid": "weather"
      }
    },
    {
      "type": "timeseries",
      "title": "Messages per hour",
      "description": "Messages each hour as a share of the 300 the sensor sends. Hours with none show as 0.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "weather"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(MinuteUtc, '1h', 0), 100.0 * SUM(Messages) / 300 AS [Received]\nFROM dbo.MinuteSummaries\nWHERE $__timeFilter(MinuteUtc)\nGROUP BY $__timeGroup(MinuteUtc, '1h', 0)\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 70,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMin": null,
            "drawStyle": "bars",
            "barAlignment": 1
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "max": 100
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Received"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "mssql",
        "uid": "weather"
      }
    },
    {
      "type": "timeseries",
      "title": "Signal",
      "description": "rtl_433's signal-to-noise ratio and signal level (RSSI) for the station's messages.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "weather"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(MinuteUtc, $__interval, NULL), AVG(SnrAvgDb) AS [SNR], AVG(RssiAvgDb) AS [RSSI]\nFROM dbo.MinuteSummaries\nWHERE $__timeFilter(MinuteUtc)\nGROUP BY $__timeGroup(MinuteUtc, $__interval)\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dB",
          "decimals": 1,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMin": null
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "SNR"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RSSI"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "mssql",
        "uid": "weather"
      }
    },
    {
      "type": "state-timeline",
      "title": "Battery",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "weather"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(MinuteUtc, '1h', NULL), MIN(CAST(BatteryOk AS int)) AS [Battery]\nFROM dbo.MinuteSummaries\nWHERE $__timeFilter(MinuteUtc)\nGROUP BY $__timeGroup(MinuteUtc, '1h', NULL)\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 0,
                "to": 0.5,
                "result": {
                  "text": "LOW",
                  "color": "red"
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 0.5,
                "to": 1,
                "result": {
                  "text": "OK",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          },
          "custom": {
            "fillOpacity": 70,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "id": 7,
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "mssql",
        "uid": "weather"
      }
    },
    {
      "type": "state-timeline",
      "title": "Data sources: green radio, blue Weather Underground, purple Weathercloud, red no outdoor sensor",
      "description": "Where each day's outdoor readings come from: the radio (this collector), else Weather Underground, else Weathercloud. Red: readings but no outdoor sensor (e.g. its failure from September 2024). Choose a long range (e.g. 5 years) to see the whole record.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "weather"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT CAST(CAST(CONVERT(date, TimeUtc AT TIME ZONE 'UTC' AT TIME ZONE 'GMT Standard Time') AS datetime2) AT TIME ZONE 'GMT Standard Time' AS datetimeoffset) AS time,\n       CASE WHEN COUNT(TemperatureAvgC) = 0 THEN 4 ELSE MIN(CASE Source WHEN 'radio' THEN 1 WHEN 'wunderground' THEN 2 ELSE 3 END) END AS [Source]\nFROM dbo.Outdoor\nWHERE $__timeFilter(TimeUtc)\nGROUP BY CONVERT(date, TimeUtc AT TIME ZONE 'UTC' AT TIME ZONE 'GMT Standard Time')\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Radio",
                  "color": "green"
                },
                "2": {
                  "text": "Weather Underground",
                  "color": "blue"
                },
                "3": {
                  "text": "Weathercloud",
                  "color": "purple"
                },
                "4": {
                  "text": "No outdoor sensor",
                  "color": "red"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "blue",
                "value": 1.5
              },
              {
                "color": "purple",
                "value": 2.5
              },
              {
                "color": "red",
                "value": 3.5
              }
            ]
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 5
      },
      "datasource": {
        "type": "mssql",
        "uid": "weather"
      }
    },
    {
      "type": "table",
      "title": "Gaps",
      "description": "Runs of more than 4 minutes with no station message (collector down, receiver trouble or no reception), newest first.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "weather"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT TOP 20 DATEADD(MINUTE, 1, previous) AS [From], MinuteUtc AS [To], DATEDIFF(MINUTE, previous, MinuteUtc) - 1 AS [Minutes missing]\nFROM (\n  SELECT MinuteUtc, LAG(MinuteUtc) OVER (ORDER BY MinuteUtc) AS previous\n  FROM dbo.MinuteSummaries\n  WHERE $__timeFilter(MinuteUtc)) AS m\nWHERE DATEDIFF(MINUTE, previous, MinuteUtc) > 5\nORDER BY [From] DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "From"
            },
            "properties": [
              {
                "id": "unit",
                "value": "time: ddd D MMM, HH:mm"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "To"
            },
            "properties": [
              {
                "id": "unit",
                "value": "time: ddd D MMM, HH:mm"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Minutes missing"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "mssql",
        "uid": "weather"
      }
    }
  ],
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "weather"
      ],
      "asDropdown": false,
      "title": "Weather",
      "includeVars": false,
      "keepTime": true
    }
  ]
}
