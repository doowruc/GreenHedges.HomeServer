    {
      "type": "stat",
      "title": "This month",
      "description": "Since the 1st of the range's last month (UK time).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "weather"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "DECLARE @to datetime2 = $__timeTo();\nDECLARE @month datetime2 = CAST(CAST(DATEFROMPARTS(YEAR(@to AT TIME ZONE 'UTC' AT TIME ZONE 'GMT Standard Time'), MONTH(@to AT TIME ZONE 'UTC' AT TIME ZONE 'GMT Standard Time'), 1) AS datetime2) AT TIME ZONE 'GMT Standard Time' AT TIME ZONE 'UTC' AS datetime2);\nSELECT ISNULL(ROUND(SUM(RainMm), 1), 0) AS [Rain] FROM dbo.MinuteSummaries WHERE MinuteUtc >= @month AND MinuteUtc <= @to"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: mm",
          "decimals": 1,
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
