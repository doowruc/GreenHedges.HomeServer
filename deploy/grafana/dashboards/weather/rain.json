            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "wideLayout": true,
        "showPercentChange": false
      },
      "id": 2,
      "gridPos": {
