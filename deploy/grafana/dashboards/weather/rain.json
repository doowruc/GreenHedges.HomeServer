      "datasource": {
        "type": "mssql",
        "uid": "weather"
      }
    },
    {
      "type": "stat",
      "title": "This year",
      "description": "Since 1 January of the range's last year (UK time). Only since the collector started.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "weather"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "DECLARE @to datetime2 = $__timeTo();\nDECLARE @year datetime2 = CAST(CAST(DATEFROMPARTS(YEAR(@to AT TIME ZONE 'UTC' AT TIME ZONE 'GMT Standard Time'), 1, 1) AS datetime2) AT TIME ZONE 'GMT Standard Time' AT TIME ZONE 'UTC' AS datetime2);\nSELECT ISNULL(ROUND(SUM(RainMm), 1), 0) AS [Rain] FROM dbo.MinuteSummaries WHERE MinuteUtc >= @year AND MinuteUtc <= @to"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: mm",
          "decimals": 1,
          "mappings": [],
