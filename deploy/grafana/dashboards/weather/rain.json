      "type": "stat",
      "title": "Rain in range",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "weather"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT ISNULL(ROUND(SUM(RainMm), 1), 0) AS [Rain] FROM dbo.MinuteSummaries WHERE $__timeFilter(MinuteUtc)"
