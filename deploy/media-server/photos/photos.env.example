# /etc/media-server/photos.env on the host (root, 0600), for media-photos.sh only. Never commit the real values. See
# HOST-SETUP.md §7.

# healthchecks.io check for the nightly photo job (period 1 day, grace 6 hours: the first run takes hours).
HEARTBEAT_PING_URL=https://hc-ping.com/<uuid>

# Optional overrides (defaults in media-photos.sh):
# PHOTOS_JOBS=3
# PHOTOS_SIZE=1920
# PHOTOS_QUALITY=85
