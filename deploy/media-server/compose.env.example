# /etc/media-server/compose.env on the host (root, 0644: nothing secret, apart from a Plex claim token for a few minutes).
# Docker Compose reads it as each server's .env: deploy-media-server.sh links /opt/jellyfin/.env and /opt/plex/.env to
# it, so plain `docker compose -f /opt/<server>/compose.yaml ...` commands find it too. HOST-SETUP.md §4 writes it from
# the host's own values; never commit the real file.

# The server's LAN address (IPv4). Jellyfin's 8096 and Plex's 32400 are published on this address only, for the Roku
# TVs. Docker's published ports bypass ufw, so the bind address is what keeps them off every other interface.
LAN_ADDRESS=192.0.2.10

# The host's media user and group (id -u media, id -g media): the servers run as them and read the media as them.
MEDIA_UID=990
MEDIA_GID=975

# The host's render group (getent group render): owns /dev/dri/renderD128, the graphics chip's video engine.
RENDER_GID=991

# Plex only: a claim token from https://plex.tv/claim, for the first start (it ties the server to the Plex account).
# Valid for 4 minutes; take it out again once Plex has started (HOST-SETUP.md §6).
PLEX_CLAIM=
