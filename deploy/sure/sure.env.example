# /etc/sure/sure.env on the host (root, 0600). Never commit the real values. Generated on the host by
# deploy/sure/HOST-SETUP.md §1; keep a copy in your password manager.

# PostgreSQL's password, for the db container and for web and worker.
POSTGRES_PASSWORD=

# Rails' secret. Never change it after first use.
SECRET_KEY_BASE=

# Keys for Sure's encrypted columns. Never change them after first use.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
