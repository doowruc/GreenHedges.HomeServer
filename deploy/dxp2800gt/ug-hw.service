[Unit]
Description=UGREEN DXP2800 GT fans and LEDs (ug-hw)
Documentation=https://github.com/doowruc/GreenHedges.HomeServer/tree/main/deploy/dxp2800gt
After=systemd-modules-load.service

[Service]
Type=simple
# Load the driver (and the LED blink trigger) if systemd-modules-load hasn't; + runs it with full privileges.
ExecStartPre=+/usr/sbin/modprobe -a ug201x ledtrig-timer
ExecStart=/usr/local/sbin/ug-hw
# However it stops (crash, kill, stop), leave the fans at full speed rather than wherever they were.
ExecStopPost=/usr/local/sbin/ug-hw failsafe
EnvironmentFile=-/etc/ug-hw/ug-hw.env
Restart=always
RestartSec=5

# It only reads hwmon and /sys/class/net and writes /proc/it86/fan and /sys/class/leds, as root.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
