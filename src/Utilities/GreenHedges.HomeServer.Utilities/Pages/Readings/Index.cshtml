@page "/{utility:utility}"
@model GreenHedges.HomeServer.Utilities.Pages.Readings.IndexModel
@{
    ViewData["Title"] = Model.Type.ToString();
    var history = Model.History;
    var unit = history.Unit;
    var perDayUnit = Model.Type.PerDayUnit(unit);
    var latest = history.Latest;
}

<h1 class="h3 mb-3"><i class="bi @Model.Type.Icon() me-2"></i>@Model.Type</h1>

@if (latest is not null)
{
    <div class="row g-3 mb-3">
        <div class="col-sm-4"><div class="card shadow-sm stat-card h-100"><div class="card-body">
            <div class="label">Latest reading</div>
            <div class="value">@UtilityUnits.FormatUnits(latest.Value) @unit.Symbol()</div>
            <div class="small text-body-secondary">@latest.Date.ToString("d MMM yyyy")</div>
        </div></div></div>
        @if (latest.Units is not null)
        {
            <div class="col-sm-4"><div class="card shadow-sm stat-card h-100"><div class="card-body">
                <div class="label">Used since the one before</div>
                <div class="value">@UtilityUnits.FormatUnits(latest.Units) @unit.Symbol()</div>
                <div class="small text-body-secondary">@latest.Days @(latest.Days == 1 ? "day" : "days")</div>
            </div></div></div>
        }
        @if (latest.UnitsPerDay is not null)
        {
            <div class="col-sm-4"><div class="card shadow-sm stat-card h-100"><div class="card-body">
                <div class="label">A day</div>
                <div class="value">@Model.Type.FormatPerDay(unit, latest.UnitsPerDay) @perDayUnit</div>
            </div></div></div>
        }
    </div>
}

<div class="card shadow-sm mb-4"><div class="card-body">
    <h2 class="h6">Add a reading</h2>
    <form method="post" class="row g-3 align-items-start">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <partial name="_ReadingFields" model="(Model.Reading, unit.Symbol())" />
        <div class="col-sm-auto reading-submit">
            <button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Add</button>
        </div>
    </form>
</div></div>

@if (history.Rows.Count == 0)
{
    <p class="text-body-secondary">No @Model.Lower readings yet. The first one is where counting starts; units used come with the second.</p>
}
else
{
    <div class="card shadow-sm mb-4">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0" data-readings>
                <thead class="table-head">
                    <tr>
                        <th>Date</th>
                        <th class="text-end">Reading</th>
                        <th class="text-end" title="The reading less the one before on the same meter">Units</th>
                        <th class="text-end" title="Days since the reading before">Days</th>
                        <th class="text-end" title="Units ÷ days@(perDayUnit == "litres" ? ", in litres (1 m³ = 1,000 litres)" : null)">@(perDayUnit == "litres" ? "Litres" : perDayUnit) a day</th>
                        <th><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody class="amount">
                @foreach (var r in history.Rows.AsEnumerable().Reverse())
                {
                    <tr>
                        <td class="text-nowrap">@r.Date.ToString("d MMM yyyy")@if (r.NewMeter) {<span class="badge text-bg-secondary ms-2" title="The first reading on a replacement meter: units are counted from its start reading">New meter</span>}</td>
                        <td class="text-end fw-semibold">@UtilityUnits.FormatUnits(r.Value)</td>
                        <td class="text-end">@UtilityUnits.FormatUnits(r.Units)</td>
                        <td class="text-end">@r.Days</td>
                        <td class="text-end">@Model.Type.FormatPerDay(unit, r.UnitsPerDay)</td>
                        <td class="text-end text-nowrap">
                            <a asp-page="Edit" asp-route-utility="@Model.Utility" asp-route-id="@r.Id" class="btn btn-sm btn-outline-secondary" title="Edit the reading for @r.Date.ToString("d MMM yyyy")"><i class="bi bi-pencil"></i></a>
                            <a asp-page="Delete" asp-route-utility="@Model.Utility" asp-route-id="@r.Id" class="btn btn-sm btn-outline-danger" title="Delete the reading for @r.Date.ToString("d MMM yyyy")"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
    <h2 class="h5 mb-0">Meters</h2>
    <a asp-page="/Meters/Create" asp-route-utility="@Model.Utility" class="btn btn-sm btn-outline-primary" title="When the meter is replaced"><i class="bi bi-plus-lg me-1"></i>New meter</a>
</div>
@if (history.Meters.Count == 0)
{
    <p class="text-body-secondary">None yet: the first reading adds one.</p>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0" data-meters>
                <thead class="table-head">
                    <tr>
                        <th>Installed</th>
                        <th class="text-end">Start reading</th>
                        <th>Serial number</th>
                        <th class="text-end">Readings</th>
                        <th><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var m in history.Meters.AsEnumerable().Reverse())
                {
                    <tr>
                        <td>@(m.InstalledOn?.ToString("d MMM yyyy") ?? "Not known")</td>
                        <td class="text-end amount">@UtilityUnits.FormatUnits(m.StartReading)</td>
                        <td>@m.SerialNumber</td>
                        <td class="text-end amount">@m.Readings</td>
                        <td class="text-end">
                            <a asp-page="/Meters/Edit" asp-route-utility="@Model.Utility" asp-route-id="@m.Id" class="btn btn-sm btn-outline-secondary" title="Edit the meter"><i class="bi bi-pencil"></i></a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
