@page "{year:int?}"
@model IndexModel
@{
    ViewData["Title"] = $"Christmas {Model.Year}";
    var gb = new System.Globalization.CultureInfo("en-GB");
}

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    @if (Model.Year > IndexModel.FirstYear)
    {
        <a asp-page="/Index" asp-route-year="@(Model.Year - 1)" class="btn btn-sm btn-outline-secondary" title="Christmas @(Model.Year - 1)"><i class="bi bi-chevron-left"></i></a>
    }
    <h1 class="h3 mb-0">Christmas @Model.Year</h1>
    @if (Model.Year < IndexModel.LastYear)
    {
        <a asp-page="/Index" asp-route-year="@(Model.Year + 1)" class="btn btn-sm btn-outline-secondary" title="Christmas @(Model.Year + 1)"><i class="bi bi-chevron-right"></i></a>
    }
    <div class="dropdown">
        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">Year</button>
        <ul class="dropdown-menu" data-years>
            @foreach (var y in Model.Years)
            {
                <li><a class="dropdown-item@(y == Model.Year ? " active" : null)" asp-page="/Index" asp-route-year="@y">@y@(y == Model.ThisYear ? " (this year)" : null)</a></li>
            }
        </ul>
    </div>
    <div class="ms-auto d-flex align-items-center gap-2">
        @if (Model.Budget is { } budget)
        {
            <span class="text-body-secondary" data-budget>Budget @budget.ToString("C", gb) each</span>
        }
        <a asp-page="/Christmases/Edit" asp-route-year="@Model.Year" class="btn btn-sm btn-outline-secondary" title="Set the budget@(Model.Exists ? ", or delete this Christmas" : null)"><i class="bi bi-sliders me-1"></i>Budget</a>
    </div>
</div>

@if (Model.Summary.Children.Count == 0)
{
    <div class="alert alert-info">No children yet. <a asp-page="/Children/Create">Add the first child</a> whose presents you'll keep here.</div>
}
else
{
    @if (Model.Summary.OverBudget)
    {
        <div class="alert alert-warning" data-over-budget>
            @string.Join(" and ", Model.Summary.Children.Where(c => c.OverBudget).Select(c => c.Name)) @(Model.Summary.Children.Count(c => c.OverBudget) == 1 ? "has" : "have")
            had more than the budget of @Model.Budget!.Value.ToString("C", gb), so everyone's cash tops them up to @Model.Summary.Target.ToString("C", gb) instead.
        </div>
    }
    <div class="row g-3 mb-2">
        @foreach (var child in Model.Summary.Children)
        {
            <div class="col-sm-6 col-lg-4">
                <div class="card shadow-sm stat-card h-100" data-child-summary><div class="card-body">
                    <div class="label">@child.Name</div>
                    <div class="value" title="Spent and cash together">@child.Total.ToString("C", gb)</div>
                    <div class="small text-body-secondary" data-spent>@child.Spent.ToString("C", gb) on @child.Presents @(child.Presents == 1 ? "present" : "presents")</div>
                    <div class="small" data-cash>
                        @if (child.Cash > 0)
                        {
                            <span class="fw-semibold text-success">+ @child.Cash.ToString("C", gb) cash</span>
                        }
                        else
                        {
                            <span class="text-body-secondary">No cash</span>
                        }
                    </div>
                </div></div>
            </div>
        }
    </div>
    @if (Model.Summary.Total > 0)
    {
        <p class="small text-body-secondary mb-3" data-year-total>
            @Model.Summary.Total.ToString("C", gb) in all@(Model.Summary.Cash > 0 ? $", {Model.Summary.Cash.ToString("C", gb)} of it cash" : null).
            Cash tops everyone up to @(Model.Budget is { } b && b >= Model.Summary.Target ? "the budget" : "whoever had most").
        </p>
    }

    <div class="card shadow-sm mb-4"><div class="card-body">
        <h2 class="h6">Add a present</h2>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <partial name="/Pages/Purchases/_PurchaseFields.cshtml" model="(Model.Purchase, Model.ChildChoices, Model.Shops, false)" />
            <div class="mt-3">
                <button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Add</button>
            </div>
        </form>
    </div></div>
}

@if (Model.Purchases.Count == 0)
{
    <p class="text-body-secondary">No presents for Christmas @Model.Year yet.</p>
}
else
{
    <div class="card shadow-sm mb-4">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0" data-purchases>
                <thead class="table-head">
                    <tr>
                        <th>Bought</th>
                        <th>For</th>
                        <th>Item</th>
                        <th>Shop</th>
                        <th class="text-end">Price</th>
                        <th class="text-end" title="Price × quantity, halved for each split">Counts as</th>
                        <th><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var p in Model.Purchases)
                {
                    <tr>
                        <td class="text-nowrap">@(p.Date?.ToString("d MMM", gb) ?? "–")</td>
                        <td>@p.Child</td>
                        <td>@p.Item</td>
                        <td>@p.Shop</td>
                        <td class="text-end amount text-nowrap">@(p.Quantity > 1 ? $"{p.Quantity} × " : null)@p.Price.ToString("C", gb)</td>
                        <td class="text-end amount text-nowrap fw-semibold">
                            @if (p.Splits is not null)
                            {
                                <i class="bi bi-scissors text-body-secondary me-1 has-tip-icon" title="@p.Splits"></i>
                            }
                            @p.Share.ToString("C", gb)
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-page="/Purchases/Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary" title="Edit @p.Item"><i class="bi bi-pencil"></i></a>
                            <a asp-page="/Purchases/Delete" asp-route-id="@p.Id" class="btn btn-sm btn-outline-danger" title="Delete @p.Item"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/purchase-share.js" asp-append-version="true"></script>
}
