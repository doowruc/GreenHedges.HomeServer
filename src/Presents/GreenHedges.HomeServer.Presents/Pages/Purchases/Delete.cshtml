@page "{id:int}"
@model GreenHedges.HomeServer.Presents.Pages.Purchases.DeleteModel
@{ ViewData["Title"] = "Delete present"; }

<h1 class="h3 mb-3">Delete present</h1>
<div class="card shadow-sm border-danger"><div class="card-body">
    <p>Are you sure you want to delete <strong>@Model.Description</strong>?</p>
    <form method="post">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="/Index" asp-route-year="@Model.Year" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div></div>
