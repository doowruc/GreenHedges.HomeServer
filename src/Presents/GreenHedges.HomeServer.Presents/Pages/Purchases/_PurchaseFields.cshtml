@using GreenHedges.HomeServer.Presents.Services
@model (PurchaseInput Purchase, IReadOnlyList<(int Id, string Name)> Children, IReadOnlyList<string> Shops, bool AskYear)
@{
    var Purchase = Model.Purchase;
    var share = Purchase.Price is { } price ? Shares.Of(price, Math.Max(Purchase.Quantity, 1), Purchase.SplitWithMum, Purchase.SplitWithBirthday) : (decimal?)null;
}
@* The purchase's fields, for the Christmas page's add form and the edit page. purchase-share.js keeps "Counts as" up to date. *@
<div class="row g-3" data-purchase-share>
    <div class="col-sm-6 col-lg-3">
        <label asp-for="@Purchase.ChildId" class="form-label"></label>
        <select asp-for="@Purchase.ChildId" class="form-select">
            <option value="">Choose…</option>
            @foreach (var (id, name) in Model.Children)
            {
                <option value="@id">@name</option>
            }
        </select>
        <span asp-validation-for="@Purchase.ChildId" class="text-danger small"></span>
    </div>
    <div class="col-sm-6 col-lg-5">
        <label asp-for="@Purchase.Item" class="form-label"></label>
        <input asp-for="@Purchase.Item" class="form-control" autofocus />
        <span asp-validation-for="@Purchase.Item" class="text-danger small"></span>
    </div>
    <div class="col-sm-6 col-lg-4">
        <label asp-for="@Purchase.Shop" class="form-label"></label>
        <input asp-for="@Purchase.Shop" class="form-control" list="shops" autocomplete="off" />
        <datalist id="shops">
            @foreach (var shop in Model.Shops)
            {
                <option value="@shop"></option>
            }
        </datalist>
        <span asp-validation-for="@Purchase.Shop" class="text-danger small"></span>
    </div>
    @if (Model.AskYear)
    {
        <div class="col-6 col-sm-3 col-lg-2">
            <label asp-for="@Purchase.Year" class="form-label"></label>
            <input asp-for="@Purchase.Year" type="number" min="2000" max="2999" class="form-control" />
            <span asp-validation-for="@Purchase.Year" class="text-danger small"></span>
        </div>
    }
    <div class="col-6 col-sm-3 col-lg-2">
        <label asp-for="@Purchase.Date" class="form-label"></label>
        <input asp-for="@Purchase.Date" type="date" class="form-control" />
        <span asp-validation-for="@Purchase.Date" class="text-danger small"></span>
    </div>
    <div class="col-6 col-sm-3 col-lg-2">
        <label asp-for="@Purchase.Price" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text">£</span>
            <input asp-for="@Purchase.Price" type="number" step="0.01" min="0.01" class="form-control amount text-end" data-share-price />
        </div>
        <span asp-validation-for="@Purchase.Price" class="text-danger small"></span>
    </div>
    <div class="col-6 col-sm-3 col-lg-2">
        <label asp-for="@Purchase.Quantity" class="form-label"></label>
        <input asp-for="@Purchase.Quantity" type="number" min="1" max="999" class="form-control amount text-end" data-share-quantity />
        <span asp-validation-for="@Purchase.Quantity" class="text-danger small"></span>
    </div>
    <div class="col-sm-6 col-lg-auto d-flex flex-column justify-content-end">
        <div class="form-check">
            <input asp-for="@Purchase.SplitWithMum" class="form-check-input" data-share-split />
            <label asp-for="@Purchase.SplitWithMum" class="form-check-label"></label>
        </div>
        <div class="form-check">
            <input asp-for="@Purchase.SplitWithBirthday" class="form-check-input" data-share-split />
            <label asp-for="@Purchase.SplitWithBirthday" class="form-check-label"></label>
        </div>
    </div>
    <div class="col-sm-6 col-lg-auto d-flex align-items-end">
        <div class="pb-2">Counts as <strong class="amount" data-share-result>@(share?.ToString("C", new System.Globalization.CultureInfo("en-GB")) ?? "–")</strong></div>
    </div>
</div>
