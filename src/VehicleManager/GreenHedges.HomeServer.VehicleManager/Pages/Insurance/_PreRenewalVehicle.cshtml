@model GreenHedges.HomeServer.VehicleManager.Pages.Insurance.PreRenewalModel.VehicleRow
@{
    // One vehicle on the pre-renewal page: the valuation sites, a form to add a value, and its values by type and grade.
    // The form shows the posted values and errors when it's the one that failed (ViewData["Posted"]).
    var posted = ViewData["Posted"] as VehicleValuationInput;
    var input = posted ?? new() { Date = Reminders.UkToday(), Mileage = Model.SuggestedMileage, Type = Model.Latest?.Type, Grade = Model.Latest?.Grade, Source = Model.Latest?.Source };
    var ownerId = ViewData["OwnerId"];
    var date = (DateOnly?)ViewData["Date"];
    var id = $"v{Model.VehicleId}";
    static string Dates(DateOnly from, DateOnly to) => from == to ? to.ToString("dd/MM/yyyy") : $"{from:dd/MM/yyyy} to {to:dd/MM/yyyy}";
    string? Error(string field) => posted is null ? null
        : ViewData.ModelState[$"Valuation.{field}"]?.Errors.FirstOrDefault()?.ErrorMessage;
}
<div class="card shadow-sm mb-3" id="vehicle-@Model.VehicleId" data-vehicle="@Model.VehicleId">
    <div class="card-header bg-body d-flex flex-wrap align-items-center gap-2">
        <a asp-page="/Vehicles/Details" asp-route-id="@Model.VehicleId" asp-route-tab="insurance" class="fw-semibold">@Model.Name</a>
        <span class="reg-plate">@Model.RegistrationNumber</span>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-copy="@Model.RegistrationNumber" title="Copy the registration"><i class="bi bi-copy"></i></button>
    </div>
    <div class="card-body">
        <div class="row g-4">
            <div class="col-lg-5">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Mileage now</dt>
                    <dd class="col-sm-7">
                        @if (Model.SuggestedMileage is { } miles)
                        {
                            <span data-pre-renewal="mileage">@miles.ToString("N0")</span>
                            <button type="button" class="btn btn-sm btn-outline-secondary ms-1" data-copy="@miles" title="Copy the mileage"><i class="bi bi-copy"></i></button>
                            <div class="text-muted small">Estimated from the latest odometer readings.</div>
                        }
                        else
                        {
                            <span class="text-muted">No odometer readings.</span>
                        }
                    </dd>
                    <dt class="col-sm-5">Miles per year</dt>
                    <dd class="col-sm-7">
                        @if (Model.MilesPerYear is { } perYear)
                        {
                            <span data-pre-renewal="miles-per-year">@perYear.ToString("N0")</span>
                            <button type="button" class="btn btn-sm btn-outline-secondary ms-1" data-copy="@perYear" title="Copy the miles per year"><i class="bi bi-copy"></i></button>
                            <div class="text-muted small">Estimated from the recent rate.</div>
                        }
                        else
                        {
                            <span class="text-muted">Not enough readings to estimate.</span>
                        }
                    </dd>
                </dl>
                <div class="mt-3 small">
                    Look it up:
                    @foreach (var site in ValuationSites.All)
                    {
                        <a href="@site.Url" target="_blank" rel="noopener noreferrer" class="ms-2">@site.Name <i class="bi bi-box-arrow-up-right"></i></a>
                    }
                </div>
            </div>
            <div class="col-lg-7">
                <form method="post" asp-page-handler="Value" asp-route-vehicleId="@Model.VehicleId" novalidate>
                    <input type="hidden" name="ownerId" value="@ownerId" />
                    @if (date is { } d) { <input type="hidden" name="date" value="@d.ToString("yyyy-MM-dd")" /> }
                    <div class="row g-2">
                        <div class="col-sm-4">
                            <label for="@id-date" class="form-label small mb-1">Date</label>
                            <input id="@id-date" name="Valuation.Date" type="date" class="form-control form-control-sm @(Error("Date") is null ? "" : "is-invalid")" value="@input.Date?.ToString("yyyy-MM-dd")" required />
                            <div class="invalid-feedback">@Error("Date")</div>
                        </div>
                        <div class="col-sm-4">
                            <label for="@id-mileage" class="form-label small mb-1">Mileage</label>
                            <input id="@id-mileage" name="Valuation.Mileage" type="number" min="0" step="1" class="form-control form-control-sm @(Error("Mileage") is null ? "" : "is-invalid")" value="@input.Mileage" required />
                            <div class="invalid-feedback">@Error("Mileage")</div>
                        </div>
                        <div class="col-sm-4">
                            <label for="@id-value" class="form-label small mb-1">Value (£)</label>
                            <input id="@id-value" name="Valuation.Value" type="number" min="0.01" step="0.01" class="form-control form-control-sm @(Error("Value") is null ? "" : "is-invalid")" value="@input.Value" required />
                            <div class="invalid-feedback">@Error("Value")</div>
                        </div>
                        <div class="col-sm-4">
                            <label for="@id-type" class="form-label small mb-1">Value type</label>
                            <select id="@id-type" name="Valuation.Type" class="form-select form-select-sm @(Error("Type") is null ? "" : "is-invalid")" required>
                                <option value="">Choose…</option>
                                @foreach (var type in Enum.GetValues<ValuationType>())
                                {
                                    <option value="@type" selected="@(input.Type == type)">@VehicleValuationView.TypeNames(type)</option>
                                }
                            </select>
                            <div class="invalid-feedback">@Error("Type")</div>
                        </div>
                        <div class="col-sm-4">
                            <label for="@id-grade" class="form-label small mb-1">Grade</label>
                            <select id="@id-grade" name="Valuation.Grade" class="form-select form-select-sm">
                                <option value="">None</option>
                                @foreach (var grade in Enum.GetValues<ValuationGrade>())
                                {
                                    <option value="@grade" selected="@(input.Grade == grade)">@grade</option>
                                }
                            </select>
                        </div>
                        <div class="col-sm-4">
                            <label for="@id-source" class="form-label small mb-1">Source</label>
                            <select id="@id-source" name="Valuation.Source" class="form-select form-select-sm @(Error("Source") is null ? "" : "is-invalid")" required>
                                <option value="">Choose…</option>
                                @foreach (var source in Enum.GetValues<ValuationSource>())
                                {
                                    <option value="@source" selected="@(input.Source == source)">@VehicleValuationView.SourceNames(source)</option>
                                }
                            </select>
                            <div class="invalid-feedback">@Error("Source")</div>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-sm btn-primary mt-3">Save value</button>
                </form>
            </div>
        </div>
        @if (Model.Summary is { } summary)
        {
            <div class="table-responsive mt-4">
                <table class="table table-sm align-middle mb-1" data-pre-renewal="values">
                    <thead class="table-head">
                        <tr>
                            <th>Type</th>
                            @foreach (var source in summary.Sources) { <th class="text-end">@VehicleValuationView.SourceNames(source)</th> }
                            <th class="text-end">Average</th>
                            <th class="text-end">Previous</th>
                            <th class="text-end">Change</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in summary.Rows)
                        {
                            <tr data-row="@row.Label">
                                <td class="text-nowrap">@row.Label</td>
                                @foreach (var source in summary.Sources)
                                {
                                    @if (row.BySource.TryGetValue(source, out var v))
                                    {
                                        <td class="text-end" title="@v.Date.ToString("dd/MM/yyyy") at @v.Mileage.ToString("N0") miles">@v.Value.ToString("C0")</td>
                                    }
                                    else
                                    {
                                        <td class="text-end text-muted">–</td>
                                    }
                                }
                                <td class="text-end fw-semibold" data-cell="average">@row.Average.ToString("C0")</td>
                                <td class="text-end text-muted" data-cell="previous">@(row.PreviousAverage?.ToString("C0") ?? "–")</td>
                                <td class="text-end @(row.Change < 0 ? "text-danger" : row.Change > 0 ? "text-success" : "")" data-cell="change">
                                    @if (row.Change is { } change) { @((change < 0 ? "−" : change > 0 ? "+" : "") + Math.Abs(change).ToString("C0")) } else { <text>–</text> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="text-muted small">
                Values from @Dates(summary.From, summary.To)@if (summary.PreviousTo is { } previousTo)
                {
                    <text>; previous from @Dates(summary.PreviousFrom!.Value, previousTo)</text>
                }. A source's latest figure in each counts; older values are on the <a asp-page="/Vehicles/Details" asp-route-id="@Model.VehicleId" asp-route-tab="insurance" asp-fragment="vehicle-values">vehicle's page</a>.
            </div>
        }
        else
        {
            <p class="text-muted small mt-3 mb-0">No values yet.</p>
        }
    </div>
</div>
