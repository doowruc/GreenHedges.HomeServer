@page
@model GreenHedges.HomeServer.VehicleManager.Pages.Insurance.PreRenewalModel
@{ ViewData["Title"] = "Pre-renewal"; }

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Pre-renewal @if (Model.OwnerName != "") { <span class="text-muted fs-5">@Model.OwnerName</span> }</h1>
        <div class="text-muted small">What a renewal quote asks for, as of the renewal date.</div>
    </div>
    <partial name="_BackButton" model='new BackButton(Url.Page("Index", new { ownerId = Model.OwnerId })!, History: true)' />
</div>

@if (Model.OwnerId is null)
{
    <div class="alert alert-info">No owners yet. <a asp-page="/Owners/Create">Add one</a>.</div>
    return;
}

<form method="get" class="card shadow-sm mb-4"><div class="card-body">
    <div class="row g-3 align-items-end">
        <div class="col-sm-6 col-md-4">
            <label for="ownerId" class="form-label">Policyholder</label>
            <select id="ownerId" name="ownerId" class="form-select" asp-items="Model.OwnerOptions" onchange="this.form.date.value = ''; this.form.submit()"></select>
        </div>
        <div class="col-sm-6 col-md-4">
            <label for="date" class="form-label">Renewal date</label>
            <input id="date" name="date" type="date" class="form-control" value="@Model.RenewalDate.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
        </div>
        <div class="col-md-4 small">
            @if (Model.CurrentPolicy is { } current)
            {
                <span>From the current <a asp-page="Details" asp-route-id="@current.Id">@current.Provider @current.PolicyNumber</a> policy, ending @current.EndDate.ToString("dd/MM/yyyy HH:mm").</span>
                @if (Model.Date is { } typed && typed != Model.DetectedRenewal)
                {
                    <a asp-route-ownerId="@Model.OwnerId" class="d-block">Back to @Model.DetectedRenewal?.ToString("dd/MM/yyyy")</a>
                }
            }
            else
            {
                <span class="text-muted">No current policy, so @(Model.Date is null ? "today" : "the date chosen").</span>
            }
        </div>
    </div>
</div></form>

@if (Model.People.Count > 1)
{
    <p class="text-muted small">With the named drivers on the @Model.BasisPolicy!.Provider @Model.BasisPolicy.PolicyNumber policy: quotes ask the same of each.</p>
}
@foreach (var person in Model.People)
{
    <partial name="_PreRenewalPerson" model="person" view-data='new ViewDataDictionary(ViewData) { ["RenewalDate"] = Model.RenewalDate }' />
}

<script>
    (() => {
        // Copy buttons: put the value on the clipboard and show a tick for a moment.
        document.querySelectorAll('[data-copy]').forEach(button => button.addEventListener('click', async () => {
            try {
                await navigator.clipboard.writeText(button.dataset.copy);
                const icon = button.querySelector('i');
                icon.className = 'bi bi-check-lg';
                setTimeout(() => { icon.className = 'bi bi-copy'; }, 1500);
            } catch { /* the clipboard isn't available (e.g. not over HTTPS): the value can still be selected */ }
        }));
    })();
</script>
