@page "/Insurance/{policyId:int}/Vehicles/Edit/{id:int}"
@model GreenHedges.HomeServer.VehicleManager.Pages.Insurance.Vehicles.EditModel
@{ ViewData["Title"] = "Edit vehicle cover on"; }

<h1 class="h3 mb-3">@ViewData["Title"] <span class="text-muted fs-5">@Model.PolicyName</span></h1>
<div class="card shadow-sm"><div class="card-body">
    <form method="post">
        @* Not in the form partial: its "for" prefix would hide page-level errors. *@
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <partial name="_PeriodForm" for="Period" />
        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-page="/Insurance/Details" asp-route-id="@Model.PolicyId" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div></div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
