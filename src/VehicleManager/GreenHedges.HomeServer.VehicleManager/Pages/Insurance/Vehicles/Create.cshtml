@page "/Insurance/{policyId:int}/Vehicles/Create"
@model GreenHedges.HomeServer.VehicleManager.Pages.Insurance.Vehicles.CreateModel
@{ ViewData["Title"] = Model.Replace is null ? "Add a vehicle to" : "Switch vehicle on"; }

<h1 class="h3 mb-3">@ViewData["Title"] <span class="text-muted fs-5">@Model.PolicyName</span></h1>
@if (Model.ReplacedVehicle is { } replaced)
{
    <p>Switching from <strong>@replaced</strong>: its cover ends when the new vehicle's starts.</p>
}
<div class="card shadow-sm"><div class="card-body">
    <form method="post">
        <input type="hidden" asp-for="Replace" />
        @* Not in the form partial: its "for" prefix would hide page-level errors. *@
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <partial name="_PeriodForm" for="Period" />
        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-page="/Insurance/Details" asp-route-id="@Model.PolicyId" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div></div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
