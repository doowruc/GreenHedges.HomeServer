@page "{id:int}"
@model GreenHedges.HomeServer.VehicleManager.Pages.Insurance.DetailsModel
@{
    var p = Model.Policy;
    ViewData["Title"] = $"{p.Provider} {p.PolicyNumber}";
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">@p.Provider <span class="text-muted fs-5">@p.PolicyNumber</span>
            @if (p.IsCurrent) { <span class="badge text-bg-success fs-6 align-middle">Current</span> }
            @if (p.IsFuture) { <span class="badge text-bg-info fs-6 align-middle">Upcoming</span> }
        </h1>
        <div class="text-muted small">@p.OwnerName's policy · @p.StartDate.ToString("dd/MM/yyyy HH:mm") to @p.EndDate.ToString("dd/MM/yyyy HH:mm") · @p.CoverName</div>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2">
        <a asp-page="Create" asp-route-renew="@p.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-arrow-repeat me-1"></i>Renew</a>
        <a asp-page="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
        <a asp-page="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-outline-danger">Delete</a>
        <partial name="_BackButton" model='new BackButton(Url.Page("Index")!, History: true)' />
    </div>
</div>

<div class="card shadow-sm mb-4"><div class="card-body">
    <dl class="row mb-0">
        <dt class="col-sm-3">Premium</dt><dd class="col-sm-9">@p.Premium.ToString("C")</dd>
        @if (p.TotalCost != p.Premium)
        {
            <dt class="col-sm-3">With adjustments</dt><dd class="col-sm-9">@p.TotalCost.ToString("C")</dd>
        }
        <dt class="col-sm-3">Total excess</dt><dd class="col-sm-9">@(p.Excess?.ToString("C") ?? "–")</dd>
        <dt class="col-sm-3">No claims bonus</dt><dd class="col-sm-9">@(p.NoClaimsYears is { } years ? $"{years} year{(years == 1 ? "" : "s")}" : "–")@(p.ProtectedNoClaims ? " (protected)" : "")</dd>
        <dt class="col-sm-3">Named drivers</dt><dd class="col-sm-9">@(p.NamedDrivers ?? "–")</dd>
        @if (p.Notes is { } notes)
        {
            <dt class="col-sm-3">Notes</dt><dd class="col-sm-9" style="white-space: pre-line">@notes</dd>
        }
    </dl>
</div></div>

<div class="card shadow-sm">
    <div class="card-header bg-body d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span class="fw-semibold">Vehicles (@p.Vehicles.Count)</span>
        <a asp-page="Vehicles/Create" asp-route-policyId="@p.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-plus-lg me-1"></i>Add vehicle</a>
    </div>
    @if (p.Vehicles.Count == 0)
    {
        <div class="card-body text-muted">No vehicles on this policy. Add one so its insurance renewal is reminded about.</div>
    }
    else
    {
        <div class="card-body py-2"><div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead class="table-head">
                <tr><th>Vehicle</th><th>Covered from</th><th>Covered to</th><th class="text-end">Adjustment</th><th class="text-end">Cost</th><th class="w-100"></th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var v in p.Vehicles)
            {
                <tr>
                    <td class="text-nowrap"><a asp-page="/Vehicles/Details" asp-route-id="@v.VehicleId" asp-route-tab="@GreenHedges.HomeServer.VehicleManager.Pages.Vehicles.DetailsModel.InsuranceTab">@v.VehicleName</a> <span class="reg-plate small">@v.RegistrationNumber</span></td>
                    <td class="text-nowrap">@v.From.ToString("dd/MM/yyyy HH:mm")</td>
                    <td class="text-nowrap">@v.To.ToString("dd/MM/yyyy HH:mm")</td>
                    <td class="text-end">@v.Adjustment?.ToString("C")</td>
                    <td class="text-end" title="Its share of the premium by time on the policy, plus its adjustment">@InsuranceCosts.Share(p, v).ToString("C")</td>
                    <td>@if (v.From <= Model.Now && Model.Now < v.To) { <span class="badge text-bg-success">Current</span> }</td>
                    <td class="text-end text-nowrap">
                        @if (v.To > Model.Now && v.To > v.From.AddMinutes(1))
                        {
                            <a asp-page="Vehicles/Create" asp-route-policyId="@p.Id" asp-route-replace="@v.Id" class="btn btn-sm btn-link p-0 me-2" title="Switch to another vehicle"><i class="bi bi-arrow-left-right"></i></a>
                        }
                        <a asp-page="Vehicles/Edit" asp-route-policyId="@p.Id" asp-route-id="@v.Id" class="btn btn-sm btn-link p-0 me-2" title="Edit"><i class="bi bi-pencil"></i></a>
                        <a asp-page="Vehicles/Delete" asp-route-policyId="@p.Id" asp-route-id="@v.Id" class="btn btn-sm btn-link p-0 text-danger" title="Remove"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
        </div></div>
    }
</div>

@if (Model.Claims.Count > 0)
{
    <div class="card shadow-sm mt-4">
        <div class="card-header bg-body fw-semibold">Claims (@Model.Claims.Count)</div>
        <ul class="list-group list-group-flush">
            @foreach (var c in Model.Claims)
            {
                <li class="list-group-item">
                    @c.Date.ToString("dd/MM/yyyy") · @c.VehicleName <span class="reg-plate small">@c.RegistrationNumber</span> · @c.TypeName
                    <span class="badge @c.FaultBadge">@c.FaultName</span> · @c.TotalValue.ToString("C")
                    <a asp-page="/Owners/Details" asp-route-id="@c.OwnerId" class="ms-1">@(c.OwnerName)'s claims</a>
                </li>
            }
        </ul>
    </div>
}
