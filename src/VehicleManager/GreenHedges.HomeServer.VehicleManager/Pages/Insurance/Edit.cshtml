@page "{id:int}"
@model GreenHedges.HomeServer.VehicleManager.Pages.Insurance.EditModel
@{ ViewData["Title"] = "Edit insurance policy"; }

<h1 class="h3 mb-3">Edit insurance policy</h1>
<div class="card shadow-sm"><div class="card-body">
    <form method="post">
        @* Not in the form partial: its "for" prefix would hide page-level errors, e.g. an edit conflict. *@
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <partial name="_InsuranceForm" for="Policy" />
        <div class="form-text mt-2">Moving the start or end moves the cover of any vehicle that starts or ends with the policy.</div>
        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-page="Details" asp-route-id="@RouteData.Values["id"]" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div></div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
