@page "/Vehicles/{vehicleId:int}/Valuations/Edit/{id:int}"
@model GreenHedges.HomeServer.VehicleManager.Pages.Vehicles.Valuations.EditModel
@{ ViewData["Title"] = "Edit value"; }

<h1 class="h3 mb-3">Edit a value for @Model.VehicleName <span class="reg-plate fs-6 align-middle">@Model.RegistrationNumber</span></h1>
<div class="card shadow-sm"><div class="card-body">
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <input type="hidden" asp-for="Valuation.RowVersion" />
        <div class="row g-3">
            <div class="col-sm-4">
                <label asp-for="Valuation.Date" class="form-label"></label>
                <input asp-for="Valuation.Date" class="form-control" />
                <span asp-validation-for="Valuation.Date" class="text-danger small"></span>
            </div>
            <div class="col-sm-4">
                <label asp-for="Valuation.Mileage" class="form-label"></label>
                <input asp-for="Valuation.Mileage" class="form-control" min="0" />
                <span asp-validation-for="Valuation.Mileage" class="text-danger small"></span>
            </div>
            <div class="col-sm-4">
                <label asp-for="Valuation.Value" class="form-label"></label>
                <input asp-for="Valuation.Value" class="form-control" min="0.01" step="0.01" />
                <span asp-validation-for="Valuation.Value" class="text-danger small"></span>
            </div>
            <div class="col-sm-4">
                <label asp-for="Valuation.Type" class="form-label"></label>
                <select asp-for="Valuation.Type" class="form-select"
                        asp-items="Enum.GetValues<ValuationType>().Select(t => new SelectListItem(VehicleValuationView.TypeNames(t), t.ToString()))">
                    <option value="">Choose…</option>
                </select>
                <span asp-validation-for="Valuation.Type" class="text-danger small"></span>
            </div>
            <div class="col-sm-4">
                <label asp-for="Valuation.Grade" class="form-label"></label>
                <select asp-for="Valuation.Grade" class="form-select" asp-items="Enum.GetValues<ValuationGrade>().Select(g => new SelectListItem(g.ToString(), g.ToString()))">
                    <option value="">None</option>
                </select>
            </div>
            <div class="col-sm-4">
                <label asp-for="Valuation.Source" class="form-label"></label>
                <select asp-for="Valuation.Source" class="form-select"
                        asp-items="Enum.GetValues<ValuationSource>().Select(s => new SelectListItem(VehicleValuationView.SourceNames(s), s.ToString()))">
                    <option value="">Choose…</option>
                </select>
                <span asp-validation-for="Valuation.Source" class="text-danger small"></span>
            </div>
        </div>
        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-page="/Vehicles/Details" asp-route-id="@Model.VehicleId" asp-route-tab="@DetailsModel.InsuranceTab" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div></div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
