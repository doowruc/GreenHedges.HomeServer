@page "/Vehicles/{vehicleId:int}/Valuations/Delete/{id:int}"
@model GreenHedges.HomeServer.VehicleManager.Pages.Vehicles.Valuations.DeleteModel
@{ ViewData["Title"] = "Delete value"; }

<h1 class="h3 mb-3">Delete value</h1>
<div class="card shadow-sm border-danger"><div class="card-body">
    <p>Delete the <strong>@Model.Valuation.Value.ToString("C0")</strong> @Model.Valuation.Label.ToLowerInvariant() value for
       <strong>@Model.VehicleName</strong> from @Model.Valuation.SourceName on <strong>@Model.Valuation.Date.ToString("dd/MM/yyyy")</strong>
       at @Model.Valuation.Mileage.ToString("N0") miles?</p>
    <form method="post">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="/Vehicles/Details" asp-route-id="@Model.VehicleId" asp-route-tab="@DetailsModel.InsuranceTab" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div></div>
