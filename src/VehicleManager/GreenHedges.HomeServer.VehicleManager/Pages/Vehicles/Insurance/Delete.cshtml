@page "/Vehicles/{vehicleId:int}/Insurance/Delete/{id:int}"
@model GreenHedges.HomeServer.VehicleManager.Pages.Vehicles.Insurance.DeleteModel
@{ ViewData["Title"] = "Delete insurance policy"; }

<h1 class="h3 mb-3">Delete insurance policy</h1>
<div class="card shadow-sm border-danger"><div class="card-body">
    <p>Delete the <strong>@Model.Policy.Provider</strong> policy @Model.Policy.PolicyNumber for <strong>@Model.VehicleName</strong>,
       @Model.Policy.StartDate.ToString("dd/MM/yyyy HH:mm") to @Model.Policy.EndDate.ToString("dd/MM/yyyy HH:mm"), @Model.Policy.Premium.ToString("C")?</p>
    <p class="text-muted small">The insurance renewal date will come from the vehicle's latest remaining policy, if it has one.</p>
    <form method="post">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="/Vehicles/Details" asp-route-id="@Model.VehicleId" asp-route-tab="@DetailsModel.InsuranceTab" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div></div>
