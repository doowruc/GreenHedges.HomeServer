@page "/Vehicles/{vehicleId:int}/Insurance/Edit/{id:int}"
@model GreenHedges.HomeServer.VehicleManager.Pages.Vehicles.Insurance.EditModel
@{ ViewData["Title"] = "Edit insurance policy"; }

<h1 class="h3 mb-3">Edit an insurance policy for @Model.VehicleName <span class="reg-plate fs-6 align-middle">@Model.RegistrationNumber</span></h1>
<div class="card shadow-sm"><div class="card-body">
    <form method="post">
        @* Not in the form partial: its "for" prefix would hide page-level errors, e.g. an edit conflict. *@
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <partial name="_InsuranceForm" for="Policy" />
        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-page="/Vehicles/Details" asp-route-id="@Model.VehicleId" asp-route-tab="@DetailsModel.InsuranceTab" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div></div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
