@page
@model GreenHedges.HomeServer.VehicleManager.Pages.Settings.IndexModel
@{ ViewData["Title"] = "Settings"; }

<h1 class="h3 mb-3">Settings</h1>
<form method="post" class="card shadow-sm mb-3"><div class="card-body">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <input type="hidden" asp-for="Settings.RowVersion" />

    <h2 class="h5">Reminders</h2>
    <p>Each morning, if a vehicle's MOT, tax, insurance or service is due in 30 or 7 days (or is overdue and you haven't
       been reminded), a reminder is emailed to this address. Leave it blank to turn reminders off.</p>
    <div class="mb-3" style="max-width: 28rem">
        <label asp-for="Settings.ReminderEmail" class="form-label"></label>
        <input asp-for="Settings.ReminderEmail" type="email" class="form-control" autocomplete="email" />
        <span asp-validation-for="Settings.ReminderEmail" class="text-danger small"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
</div></form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
