@page "/Owners/{ownerId:int}/Claims/Create"
@model GreenHedges.HomeServer.VehicleManager.Pages.Owners.Claims.CreateModel
@{ ViewData["Title"] = "Add a claim"; }

<h1 class="h3 mb-3">Add a claim <span class="text-muted fs-5">@Model.OwnerName</span></h1>
<div class="card shadow-sm"><div class="card-body">
    <form method="post">
        @* Not in the form partial: its "for" prefix would hide page-level errors. *@
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <partial name="_ClaimForm" for="Claim" />
        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-page="/Owners/Details" asp-route-id="@Model.OwnerId" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div></div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
