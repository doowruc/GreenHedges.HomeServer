{
  "Rtl433": {
    "Path": "rtl_433",
    "Arguments": "-f 868.3M -s 1024k -R 172 -M time:unix:usec -M level -M protocol -F json",
    "SilenceTimeout": "00:02:00",
    "MinRestartDelay": "00:00:05",
    "MaxRestartDelay": "00:05:00",
    "StableAfter": "00:10:00"
  },
  "Station": {
    "Model": "Bresser-6in1",
    "DeviceIds": []
  },
  "Alerts": {
    "ResendApiKey": "",
    "From": "",
    "To": [],
    "StationSilentAfter": "00:05:00",
    "ReceiverEndsPerHour": 3,
    "BatteryLowAfter": "01:00:00",
    "PublishStalledAfter": "00:30:00",
    "WundergroundFailingAfter": "06:00:00"
  },
  "Heartbeat": {
    "PingUrl": "",
    "Interval": "00:05:00"
  },
  "Backup": {
    "Enabled": true,
    "Directory": "backups",
    "TimeOfDay": "03:30:00",
    "Retain": 7
  },
  "Offsite": {
    "Bucket": "",
    "Region": "",
    "Prefix": "weathercollector",
    "StorageClass": "STANDARD",
    "AgePath": "age",
    "CheckInterval": "01:00:00"
  },
  "Archive": {
    "DatabasePath": "weathercollector.db"
  },
  "ConnectionStrings": {
    "Weather": ""
  },
  "Summaries": {
    "Interval": "00:01:00",
    "BatchSize": 5000,
    "TimeZone": "Europe/London"
  },
  "Wunderground": {
    "StationId": "",
    "ApiKey": "",
    "From": "2021-11-07",
    "TimeZone": "Europe/London",
    "RunAt": "04:30:00",
    "MaxCallsPerDay": 1000,
    "CallInterval": "00:00:02.5",
    "CompleteAfter": "1.00:00:00"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/weathercollector-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31
        }
      }
    ]
  }
}
