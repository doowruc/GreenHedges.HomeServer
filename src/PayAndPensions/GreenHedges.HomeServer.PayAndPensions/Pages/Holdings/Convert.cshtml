@page "/People/{personId:int}/Pensions/{pensionId:int}/Holdings/Convert"
@model GreenHedges.HomeServer.PayAndPensions.Pages.Holdings.ConvertModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{ ViewData["Title"] = "Record a conversion"; }

<h1 class="h3 mb-1">Record a conversion</h1>
<p class="text-body-secondary">@Model.PensionName, @Model.PersonName's pension with @Model.ProviderName</p>
<div class="card shadow-sm"><div class="card-body">
    <p>When a provider converts a fund to another, such as one share class to another, the transaction history leaves it out.
        Record it here: all the units held of one fund on the date (worked out from the transactions) become the units
        received of the other, which take over their cost as it stands on the date. Your provider's statement or current holdings give the units received.</p>
    @if (Model.Funds.Count == 0)
    {
        <div class="alert alert-info mb-0">The pension has no purchases or sales of funds to convert.</div>
    }
    else
    {
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="row g-3">
                <div class="col-md-3">
                    <label asp-for="Conversion.Date" class="form-label"></label>
                    <input asp-for="Conversion.Date" type="date" class="form-control" />
                    <span asp-validation-for="Conversion.Date" class="text-danger small"></span>
                </div>
                <div class="col-md-9">
                    <label asp-for="Conversion.FromFund" class="form-label"></label>
                    <select asp-for="Conversion.FromFund" asp-items="@(new SelectList(Model.Funds))" class="form-select">
                        <option value="">Choose a fund</option>
                    </select>
                    <span asp-validation-for="Conversion.FromFund" class="text-danger small"></span>
                </div>
                <div class="col-md-9">
                    <label asp-for="Conversion.ToFund" class="form-label"></label>
                    <input asp-for="Conversion.ToFund" list="funds" class="form-control" />
                    <datalist id="funds">
                        @foreach (var f in Model.Funds) { <option value="@f"></option> }
                    </datalist>
                    <span asp-validation-for="Conversion.ToFund" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Conversion.Units" class="form-label"></label>
                    <input asp-for="Conversion.Units" type="number" step="0.000001" min="0" class="form-control" />
                    <span asp-validation-for="Conversion.Units" class="text-danger small"></span>
                </div>
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-primary">Record</button>
                <a asp-page="Index" asp-route-personId="@Model.PersonId" asp-route-pensionId="@Model.PensionId" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    }
</div></div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
