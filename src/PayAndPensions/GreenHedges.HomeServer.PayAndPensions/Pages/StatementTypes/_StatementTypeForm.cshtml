@model StatementTypeInput
<input type="hidden" asp-for="RowVersion" />
<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" autofocus />
        <span asp-validation-for="Name" class="text-danger small"></span>
        <div class="form-text">E.g. "Investment report" or "Annual illustration".</div>
    </div>
    <div class="col-12">
        <div class="form-check">
            <input asp-for="HasProjections" class="form-check-input" />
            <label asp-for="HasProjections" class="form-check-label"></label>
        </div>
        <span asp-validation-for="HasProjections" class="text-danger small"></span>
    </div>
</div>
