@page "/People/{personId:int}/Pensions/{pensionId:int}/StatementTypes/Create"
@model GreenHedges.HomeServer.PayAndPensions.Pages.StatementTypes.CreateModel
@{ ViewData["Title"] = "Add statement type"; }

<h1 class="h3 mb-3">Add a statement type to @Model.PensionName</h1>
<div class="card shadow-sm"><div class="card-body">
    <form method="post">
        @* Not in the form partial: its "for" prefix would hide page-level errors, e.g. an edit conflict. *@
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <partial name="_StatementTypeForm" for="Type" />
        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-page="/Statements/Index" asp-route-personId="@Model.PersonId" asp-route-pensionId="@Model.PensionId" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div></div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
