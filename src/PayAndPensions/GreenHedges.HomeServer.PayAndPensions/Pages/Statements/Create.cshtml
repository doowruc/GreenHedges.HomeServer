@page "/People/{personId:int}/Pensions/{pensionId:int}/Statements/Create"
@model GreenHedges.HomeServer.PayAndPensions.Pages.Statements.CreateModel
@{ ViewData["Title"] = "Add statement"; }

<h1 class="h3 mb-3">Add a statement to @Model.PensionName</h1>
<div class="card shadow-sm"><div class="card-body">
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <partial name="_StatementForm" model="Model" />
        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-page="Index" asp-route-personId="@Model.PersonId" asp-route-pensionId="@Model.PensionId" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div></div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/statement-income.js" asp-append-version="true"></script>
}
