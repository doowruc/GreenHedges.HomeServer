@model GreenHedges.HomeServer.PayAndPensions.Pages.Statements.StatementFormModel
<input type="hidden" asp-for="Statement.RowVersion" />
<div class="row g-3">
    <div class="col-md-4">
        <label asp-for="Statement.StatementTypeId" class="form-label"></label>
        <select asp-for="Statement.StatementTypeId" asp-items="Model.TypeOptions" class="form-select"></select>
        <span asp-validation-for="Statement.StatementTypeId" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Statement.Date" class="form-label"></label>
        <input asp-for="Statement.Date" type="date" class="form-control" />
        <span asp-validation-for="Statement.Date" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Statement.Label" class="form-label"></label>
        <input asp-for="Statement.Label" class="form-control" />
        <span asp-validation-for="Statement.Label" class="text-danger small"></span>
        <div class="form-text">E.g. "Spring 2026".</div>
    </div>
    <div class="w-100 m-0"></div>
    <div class="col-md-3">
        <label asp-for="Statement.Value" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text">£</span>
            <input asp-for="Statement.Value" type="number" step="0.01" class="form-control amount text-end" autofocus />
        </div>
        <span asp-validation-for="Statement.Value" class="text-danger small"></span>
    </div>
    @if (Model.Types.Any(t => t.HasProjections))
    {
        <div class="col-md-3">
            <label asp-for="Statement.ProjectedFund" class="form-label"></label>
            <div class="input-group">
                <span class="input-group-text">£</span>
                <input asp-for="Statement.ProjectedFund" type="number" step="0.01" class="form-control amount text-end" />
            </div>
            <span asp-validation-for="Statement.ProjectedFund" class="text-danger small"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Statement.ProjectedAnnualIncome" class="form-label"></label>
            <div class="input-group">
                <span class="input-group-text">£</span>
                <input asp-for="Statement.ProjectedAnnualIncome" type="number" step="0.01" class="form-control amount text-end" data-annual-income />
            </div>
            <span asp-validation-for="Statement.ProjectedAnnualIncome" class="text-danger small"></span>
        </div>
        @* No name, so it isn't posted: statement-income.js keeps it and the annual income in step, and only the annual is stored. *@
        <div class="col-md-3">
            <label for="projected-monthly-income" class="form-label">Projected monthly income</label>
            <div class="input-group">
                <span class="input-group-text">£</span>
                <input id="projected-monthly-income" type="number" step="0.01" min="0" class="form-control amount text-end" data-monthly-income />
            </div>
            <div class="form-text">Either fills in the other; the annual is what's kept.</div>
        </div>
        <div class="col-12 form-text mt-1">The projections are for types with projections (@string.Join(", ", Model.Types.Where(t => t.HasProjections).Select(t => t.Name))) only.</div>
    }
    <div class="col-12">
        <label asp-for="Statement.Notes" class="form-label"></label>
        <textarea asp-for="Statement.Notes" class="form-control" rows="2"></textarea>
        <span asp-validation-for="Statement.Notes" class="text-danger small"></span>
    </div>
</div>
