@page "/People/{personId:int}/Payslips"
@model GreenHedges.HomeServer.PayAndPensions.Pages.Payslips.IndexModel
@using GreenHedges.HomeServer.PayAndPensions.Services
@{
    var year = Model.Year!.Value;
    ViewData["Title"] = $"{Model.PersonName}'s payslips {TaxYears.Label(year)}";
    static string Money(decimal? value) => value is { } v ? v.ToString("N2") : "";
    static string Percent(decimal? value) => value is { } v ? v.ToString("P1") : "";
    var t = Model.Totals;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">@Model.PersonName's payslips</h1>
    <div class="d-flex gap-2">
        <form method="get" class="d-flex">
            <label for="year" class="visually-hidden">Tax year</label>
            <select id="year" name="year" class="form-select form-select-sm" onchange="this.form.submit()">
                @foreach (var y in Model.Years)
                {
                    <option value="@y" selected="@(y == year)">@TaxYears.Label(y)</option>
                }
            </select>
            <noscript><button type="submit" class="btn btn-sm btn-outline-secondary ms-1">Show</button></noscript>
        </form>
        <a asp-page="/Years/Index" asp-route-personId="@Model.PersonId" class="btn btn-sm btn-outline-secondary text-nowrap">Tax years</a>
        <a asp-page="/Import/Index" asp-route-personId="@Model.PersonId" class="btn btn-sm btn-outline-secondary text-nowrap"><i class="bi bi-file-earmark-arrow-up me-1"></i>Import</a>
        <a asp-page="Create" asp-route-personId="@Model.PersonId" class="btn btn-sm btn-primary text-nowrap"><i class="bi bi-plus-lg me-1"></i>Add payslip</a>
    </div>
</div>

@if (Model.Rows.Count == 0)
{
    <div class="alert alert-info">No payslips for @TaxYears.Label(year) yet. <a asp-page="Create" asp-route-personId="@Model.PersonId">Add one</a>,
        or <a asp-page="/Import/Index" asp-route-personId="@Model.PersonId">import a spreadsheet</a> of them.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            @* Sections, each ending in a separator (.section-end): the payslip; earnings; deductions; the employer's and
               when the pension arrived; gross and deductions; net; the worked-out figures. A payslip's notes are a
               tooltip on its month, and a pension or bonus amount's share of salary a tooltip on the amount. *@
            <table class="table table-sm table-hover align-middle mb-0 payslip-table">
                <thead class="table-head">
                    <tr>
                        <th>Month</th>
                        <th class="@(Model.ManyEmployers ? null : "section-end")">Paid</th>
                        @if (Model.ManyEmployers) { <th class="section-end">Employer</th> }
                        @foreach (var c in Model.Columns)
                        {
                            <th class="text-end @(c.EndsGroup ? "section-end" : null)">@c.Name</th>
                        }
                        @if (Model.ShowPensionReceived) { <th class="section-end">Pension received</th> }
                        <th class="text-end">Gross</th>
                        <th class="text-end section-end">Deductions</th>
                        <th class="text-end section-end">Net</th>
                        <th class="text-end">Annual salary</th>
                        <th class="text-end">Rise</th>
                        <th class="text-end">Take-home</th>
                        <th class="text-end">Year to date</th>
                        <th class="text-end section-end" title="12 ÷ tax month × year to date">Predicted</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody class="amount">
                @foreach (var r in Model.Rows)
                {
                    var f = r.Figures;
                    <tr>
                        <td class="text-nowrap"><span title="Tax month @r.TaxMonth">@r.TaxMonth @TaxYears.MonthName(r.TaxMonth)[..3]</span>@if (r.Notes is not null) {<i class="bi bi-sticky ms-1 text-body-secondary has-tip-icon" title="@r.Notes" aria-label="Notes: @r.Notes"></i>}</td>
                        <td class="text-nowrap @(Model.ManyEmployers ? null : "section-end")">@r.PayDate.ToString("dd/MM/yy")</td>
                        @if (Model.ManyEmployers) { <td class="section-end">@r.Employer</td> }
                        @foreach (var c in Model.Columns)
                        {
                            var amount = r.Amounts.TryGetValue(c.Id, out var a) ? a : (decimal?)null;
                            // A pension amount's tooltip is it as a % of the month's salary; a bonus's, as a % of the annual salary.
                            var tip = amount is not { } p || p == 0 ? null
                                : c.Category == PayCategory.Pension && f.Salary != 0 ? $"{(p / f.Salary).ToString("P1")} of salary"
                                : c.Category == PayCategory.Bonus && c.Kind == PayElementKind.Earning && f.AnnualSalary != 0 ? $"{(p / f.AnnualSalary).ToString("P1")} of annual salary"
                                : null;
                            <td class="text-end @(c.EndsGroup ? "section-end" : null)">@if (tip is null) {@Money(amount)} else {<span class="has-tip" title="@tip">@Money(amount)</span>}</td>
                        }
                        @if (Model.ShowPensionReceived) { <td class="text-nowrap section-end">@r.PensionReceivedDate?.ToString("dd/MM/yy")</td> }
                        <td class="text-end">@Money(f.Gross)</td>
                        <td class="text-end section-end">@Money(f.Deductions)</td>
                        <td class="text-end fw-semibold section-end">@Money(f.Net)</td>
                        <td class="text-end">@Money(f.AnnualSalary)</td>
                        <td class="text-end text-nowrap">@if (f.Rise is { } rise) {<span class="has-tip" title="@((f.RisePercent ?? 0) >= 0 ? "+" : "")@Percent(f.RisePercent) on the annual salary before">@Money(rise)</span>}</td>
                        <td class="text-end">@Percent(f.TakeHomePercent)</td>
                        <td class="text-end">@Money(f.YearToDateGross)</td>
                        <td class="text-end section-end">@Money(f.PredictedAnnualGross)</td>
                        <td class="text-end text-nowrap">
                            <a asp-page="Edit" asp-route-personId="@Model.PersonId" asp-route-id="@r.Id" class="btn btn-sm btn-outline-secondary" title="Edit"><i class="bi bi-pencil"></i></a>
                            <a asp-page="Delete" asp-route-personId="@Model.PersonId" asp-route-id="@r.Id" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    @if (t is not null)
    {
        <h2 class="h5 mt-4">@TaxYears.Label(year) totals <span class="text-body-secondary small">(@t.Payslips @(t.Payslips == 1 ? "payslip" : "payslips"))</span></h2>
        <div class="card shadow-sm"><div class="card-body">
            <dl class="row mb-0 amount">
                <dt class="col-sm-4 col-lg-3">Gross</dt>
                <dd class="col-sm-8 col-lg-3">£@Money(t.Gross)@if (t.GrossChange is { } gc) {<span class="text-body-secondary small ms-2">@(gc >= 0 ? "+" : "")@Money(gc) (@Percent(t.GrossChangePercent)) on the same months of @TaxYears.Label(year - 1)</span>}</dd>
                <dt class="col-sm-4 col-lg-3">Net</dt>
                <dd class="col-sm-8 col-lg-3">£@Money(t.Net)@if (t.NetChange is { } nc) {<span class="text-body-secondary small ms-2">@(nc >= 0 ? "+" : "")@Money(nc) (@Percent(t.NetChangePercent))</span>}</dd>
                <dt class="col-sm-4 col-lg-3">Tax</dt>
                <dd class="col-sm-8 col-lg-3">£@Money(t.Tax)</dd>
                <dt class="col-sm-4 col-lg-3">National Insurance</dt>
                <dd class="col-sm-8 col-lg-3">£@Money(t.NationalInsurance)</dd>
                <dt class="col-sm-4 col-lg-3">Pension (yours)</dt>
                <dd class="col-sm-8 col-lg-3">£@Money(t.EmployeePension)</dd>
                <dt class="col-sm-4 col-lg-3">Pension (employer's)</dt>
                <dd class="col-sm-8 col-lg-3">£@Money(t.EmployerPension)</dd>
                <dt class="col-sm-4 col-lg-3" title="20% of your pension contributions, reclaimed through Self Assessment by a higher-rate taxpayer with a relief-at-source pension">Higher-rate pension relief</dt>
                <dd class="col-sm-8 col-lg-3">£@Money(t.PensionRelief)</dd>
                <dt class="col-sm-4 col-lg-3">Take-home</dt>
                <dd class="col-sm-8 col-lg-3">@Percent(t.TakeHomePercent) of gross</dd>
            </dl>
        </div></div>
    }
}
<a asp-page="/People/Index" class="btn btn-sm btn-outline-secondary mt-3"><i class="bi bi-arrow-left me-1"></i>People</a>
