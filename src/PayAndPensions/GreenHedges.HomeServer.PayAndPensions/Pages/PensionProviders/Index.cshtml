@page
@model GreenHedges.HomeServer.PayAndPensions.Pages.PensionProviders.IndexModel
@{ ViewData["Title"] = "Pension providers"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Pension providers</h1>
    <a asp-page="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Add provider</a>
</div>

@if (Model.Providers.Count == 0)
{
    <div class="alert alert-info">No pension providers yet. <a asp-page="Create">Add one</a>: every pension is with a provider, and people can share one.</div>
}
else
{
    <div class="card shadow-sm">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-head">
                <tr><th>Name</th><th>Website</th><th>Pensions</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var pp in Model.Providers)
            {
                <tr>
                    <td>@pp.Name</td>
                    <td>@if (pp.Website is not null) { <a href="@pp.Website" target="_blank" rel="noopener noreferrer">@(new Uri(pp.Website).Host)<i class="bi bi-box-arrow-up-right small ms-1"></i></a> }</td>
                    <td>
                        @foreach (var pn in pp.Pensions)
                        {
                            <a asp-page="/Pensions/Index" asp-route-personId="@pn.PersonId" class="d-block">@pn.PersonName: @pn.Name</a>
                        }
                    </td>
                    <td class="text-end text-nowrap">
                        <a asp-page="Edit" asp-route-id="@pp.Id" class="btn btn-sm btn-outline-secondary" title="Edit"><i class="bi bi-pencil"></i></a>
                        <a asp-page="Delete" asp-route-id="@pp.Id" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
