@page "/People/{personId:int}/Employers/Create"
@model GreenHedges.HomeServer.PayAndPensions.Pages.Employers.CreateModel
@{ ViewData["Title"] = "Add employer"; }

<h1 class="h3 mb-3">Add an employer for @Model.PersonName</h1>
<div class="card shadow-sm"><div class="card-body">
    <form method="post">
        @* Not in the form partial: its "for" prefix would hide page-level errors, e.g. an edit conflict. *@
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <partial name="_EmployerForm" for="Employer" />
        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-page="Index" asp-route-personId="@Model.PersonId" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div></div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
