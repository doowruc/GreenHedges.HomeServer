@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService Auth
<!DOCTYPE html>
<html lang="en-GB" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Pay &amp; Pensions</title>
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#212529" />
    <meta name="apple-mobile-web-app-title" content="Pay" />
    <script src="~/js/color-mode.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var signedIn = User.Identity?.IsAuthenticated == true;
        var allowed = signedIn && (await Auth.AuthorizeAsync(User, AllowedUsers.PolicyName)).Succeeded;
    }
    <nav class="navbar navbar-expand-sm bg-dark border-bottom mb-4" data-bs-theme="dark">
        <div class="container">
            <a class="navbar-brand" asp-page="/Index"><i class="bi bi-cash-stack me-2"></i>Pay &amp; Pensions</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="nav">
                <ul class="navbar-nav me-auto">
                    @if (allowed)
                    {
                        <li class="nav-item"><a class="nav-link" asp-page="/Index">Dashboard</a></li>
                        @* Pay now; Pensions (pots) joins it later. *@
                        <li class="nav-item dropdown">
                            <button class="nav-link dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">Pay</button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-page="/People/Index">People</a></li>
                            </ul>
                        </li>
                    }
                </ul>
                <div class="d-flex align-items-center gap-2">
                    @if (signedIn)
                    {
                        @* Clicks inside don't close it (auto-close "outside"), so Theme can open its options in place;
                           color-mode.js closes it once a theme is chosen. It opens from its left edge on a phone (where the
                           collapsed menu puts the button on the left) and its right edge otherwise; that needs display static. *@
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button"
                                    data-bs-toggle="dropdown" data-bs-auto-close="outside" data-bs-display="static" aria-expanded="false" aria-label="Account" title="@User.Identity!.Name">
                                <i class="bi bi-person-circle"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-sm-end">
                                <li><h6 class="dropdown-header">@User.Identity!.Name</h6></li>
                                <li>
                                    <button class="dropdown-item d-flex align-items-center" type="button" data-bs-toggle="collapse"
                                            data-bs-target="#theme-options" aria-expanded="false" aria-controls="theme-options">
                                        <i class="bi bi-circle-half me-2" id="theme-icon"></i>Theme
                                        <span class="ms-auto ps-3 small text-body-secondary" id="theme-name">System</span>
                                        <i class="bi bi-chevron-down small ms-2"></i>
                                    </button>
                                </li>
                                <li class="collapse" id="theme-options">
                                    <ul class="list-unstyled ps-3">
                                        <li><button type="button" class="dropdown-item" data-theme-value="light"><i class="bi bi-sun-fill me-2"></i>Light</button></li>
                                        <li><button type="button" class="dropdown-item" data-theme-value="dark"><i class="bi bi-moon-stars-fill me-2"></i>Dark</button></li>
                                        <li><button type="button" class="dropdown-item" data-theme-value="auto"><i class="bi bi-circle-half me-2"></i>System</button></li>
                                    </ul>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form method="post" asp-page="/Account/Logout">
                                        <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2"></i>Sign out</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </div>
    </nav>

    <main class="container pb-5">
        @if (TempData["Message"] is string message)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @message
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Warning"] is string warning)
        {
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                @warning
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
