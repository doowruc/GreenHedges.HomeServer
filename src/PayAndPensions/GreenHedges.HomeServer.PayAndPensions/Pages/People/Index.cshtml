@page
@model GreenHedges.HomeServer.PayAndPensions.Pages.People.IndexModel
@{ ViewData["Title"] = "People"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">People</h1>
    <a asp-page="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Add person</a>
</div>

@if (Model.People.Count == 0)
{
    <div class="alert alert-info">No people yet. <a asp-page="Create">Add the first person</a>, whose pay you'll keep here.</div>
}
else
{
    <div class="card shadow-sm">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-head">
                <tr><th>Name</th><th class="text-end">Employers</th><th class="text-end">Pay elements</th><th class="text-end">Payslips</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var p in Model.People)
            {
                <tr>
                    <td>@p.Name</td>
                    <td class="text-end"><a asp-page="/Employers/Index" asp-route-personId="@p.Id" title="Employers">@p.Employers</a></td>
                    <td class="text-end"><a asp-page="/PayElements/Index" asp-route-personId="@p.Id" title="Pay elements">@p.PayElements</a></td>
                    <td class="text-end"><a asp-page="/Payslips/Index" asp-route-personId="@p.Id" title="Payslips">@p.Payslips</a></td>
                    <td class="text-end text-nowrap">
                        <a asp-page="/Import/Index" asp-route-personId="@p.Id" class="btn btn-sm btn-outline-secondary" title="Import payslips"><i class="bi bi-file-earmark-arrow-up"></i></a>
                        <a asp-page="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary" title="Edit"><i class="bi bi-pencil"></i></a>
                        <a asp-page="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
