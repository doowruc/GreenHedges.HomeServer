@page "/People/{personId:int}/Pensions/Create"
@model GreenHedges.HomeServer.PayAndPensions.Pages.Pensions.CreateModel
@{ ViewData["Title"] = "Add pension"; }

<h1 class="h3 mb-3">Add a pension for @Model.PersonName</h1>
<div class="card shadow-sm"><div class="card-body">
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <partial name="_PensionForm" model="Model" />
        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-page="Index" asp-route-personId="@Model.PersonId" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div></div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
