@page "/People/{personId:int}/Pensions"
@using Microsoft.AspNetCore.Mvc.Rendering
@model GreenHedges.HomeServer.PayAndPensions.Pages.Pensions.IndexModel
@{
    ViewData["Title"] = $"{Model.PersonName}'s pensions";
    string Label(PensionType value) => Html.GetEnumSelectList<PensionType>().First(i => i.Value == ((int)value).ToString()).Text;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@Model.PersonName's pensions</h1>
    <a asp-page="Create" asp-route-personId="@Model.PersonId" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Add pension</a>
</div>

@if (!Model.HasProviders)
{
    <div class="alert alert-info">No pension providers yet. <a asp-page="/PensionProviders/Create">Add a provider</a> first: every pension is with one.</div>
}
else if (Model.Pensions.Count == 0)
{
    <div class="alert alert-info">No pensions yet. <a asp-page="Create" asp-route-personId="@Model.PersonId">Add one</a>.</div>
}
@if (Model.Pensions.Count > 0)
{
    <div class="card shadow-sm">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-head">
                <tr><th>Name</th><th>Provider</th><th>Type</th><th>Policy number</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var pn in Model.Pensions)
            {
                <tr>
                    <td>@pn.Name</td>
                    <td>
                        @if (pn.Website is not null) { <a href="@pn.Website" target="_blank" rel="noopener noreferrer">@pn.Provider<i class="bi bi-box-arrow-up-right small ms-1"></i></a> }
                        else { @pn.Provider }
                    </td>
                    <td>@Label(pn.Type)</td>
                    <td>@pn.PolicyNumber</td>
                    <td class="text-end text-nowrap">
                        <a asp-page="Edit" asp-route-personId="@Model.PersonId" asp-route-id="@pn.Id" class="btn btn-sm btn-outline-secondary" title="Edit"><i class="bi bi-pencil"></i></a>
                        <a asp-page="Delete" asp-route-personId="@Model.PersonId" asp-route-id="@pn.Id" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
<a asp-page="/PensionProviders/Index" class="btn btn-sm btn-outline-secondary mt-3"><i class="bi bi-building me-1"></i>Pension providers</a>
