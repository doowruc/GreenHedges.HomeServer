@page "/People/{personId:int}/Pensions/Delete/{id:int}"
@model GreenHedges.HomeServer.PayAndPensions.Pages.Pensions.DeleteModel
@{ ViewData["Title"] = "Delete pension"; }

<h1 class="h3 mb-3">Delete @Model.PersonName's pension</h1>
<div class="card shadow-sm border-danger"><div class="card-body">
    @if (Model.Payslips > 0 || Model.Statements > 0 || Model.Transactions > 0)
    {
        var reasons = new[] { Model.Payslips > 0 ? $"payslips go to it ({Model.Payslips})" : null, Model.Statements > 0 ? $"it has statements ({Model.Statements})" : null,
            Model.Transactions > 0 ? $"it has transactions ({Model.Transactions})" : null };
        <p><strong>@Model.PensionName</strong> can't be deleted while @string.Join(" or ", reasons.OfType<string>()).</p>
        <a asp-page="Index" asp-route-personId="@Model.PersonId" class="btn btn-outline-secondary">Back</a>
    }
    else
    {
        <p>Are you sure you want to delete <strong>@Model.PensionName</strong>?</p>
        <form method="post">
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-page="Index" asp-route-personId="@Model.PersonId" class="btn btn-outline-secondary">Cancel</a>
        </form>
    }
</div></div>
