<Project>
  <ItemGroup>
    <PackageVersion Include="AWSSDK.S3" Version="4.0.104.4" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <!-- The Weather collector's summaries in SQL Server. The version EF Core (Vehicle Manager) brings in, so both match. -->
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="6.1.6" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.0.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageVersion Include="Serilog.Settings.Configuration" Version="9.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <!-- Vehicle Manager. Keep the EF Core packages on one version, and dotnet-ef (dotnet-tools.json) on the same. -->
    <PackageVersion Include="Auth0.AspNetCore.Authentication" Version="1.11.0" />
    <PackageVersion Include="ClosedXML" Version="0.105.1" />
    <PackageVersion Include="Coravel" Version="6.0.2" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.SqlClient" Version="1.20.0" />
    <PackageVersion Include="Resend" Version="0.23.0" />
    <!-- Security pins for transitive packages; remove each once its parent depends on a fixed version.
         Microsoft.Data.SqlClient (via EF Core, and in the Weather collector's summaries) brings in 9.0.11, which has denial-of-service advisories
         (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7); 10.0.13 is fixed. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <!-- Aspire.Hosting (Vehicle Manager's AppHost) brings in 2.5.302, which has a denial-of-service advisory
         (GHSA-qhrr-8q5h-9q3h); 2.5.303 is fixed. -->
    <PackageVersion Include="MessagePack" Version="2.5.303" />
    <!-- Tests -->
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
</Project>
